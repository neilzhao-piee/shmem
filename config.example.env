# shmem configuration — copy to /etc/shmem.env (or source it) and adjust.
# All variables are read by the tools; nothing is baked in.

# --- Core ---
# Directory holding INDEX.md, facts/, journal/, inbox/ (and tools/ if you run them from here).
SHMEM_ROOT=/path/to/your/memory

# Timezone for journal dates and logs (IANA name).
SHMEM_TZ=UTC

# --- tools/memory-search.py ---
# Optional: colon-separated credential files whose VALUES must never be indexed.
# The indexer reads these files and drops any indexed line containing one of their values.
SHMEM_SECRET_FILES=

# Optional vector layer (off unless both are set). OpenAI-compatible embeddings endpoint.
SHMEM_EMBED_BASE_URL=
SHMEM_EMBED_MODEL=

# --- tools/summarize-sessions.py ---
# OpenAI-compatible chat completions endpoint. Leave EMPTY to run keyword-fallback only.
SUMMARIZE_MODEL_URL=
SUMMARIZE_MODEL=
SUMMARIZE_MODEL_TIMEOUT=120
SUMMARIZE_MAX_TOKENS=4000

# Session sources for the reference adapters (defaults match DSH / hermes conventions).
DSH_SESSIONS_GLOB=~/.dsh/sessions/*/*/session.v4.jsonl.zstd
HERMES_STATE_DB=~/.hermes/state.db

# --- integrations/dsh/update-agents-block.sh ---
# The DSH bootstrap file that gets the auto-injected block.
DSH_AGENTS_MD=$HOME/.dsh/AGENTS.md

# --- integrations/hermes/ ---
# Directory holding the other agent's private memory files (MEMORY.md / USER.md).
HERMES_MEM_DIR=$HOME/.hermes/memories
# Label prefixed to the injected digest (any text you like).
SHMEM_HOOK_LABEL=Shared memory (auto-injected): the digest below is shared with the other agents; full entries live in the shmem root — read the files directly for detail.
